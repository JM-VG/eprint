APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Data lives in the Firebase Realtime Database (FIREBASE_* below); there is no
# SQL database. DB_* only describe an old MySQL database to copy into Firebase
# once with: php artisan firebase:import --connection=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eprint
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
EPRINT_DOCX_CONVERSION=false
EPRINT_SOFFICE_PATH=soffice

# Firebase Realtime Database
# Put the service account JSON outside version control at this path, or set
# FIREBASE_CREDENTIALS_JSON to the raw JSON for hosting platforms.
FIREBASE_DRIVER=auto
FIREBASE_PROJECT_ID=e-print-e1185
FIREBASE_DATABASE_URL=https://e-print-e1185-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_CREDENTIALS=storage/app/firebase/service-account.json
# FIREBASE_CREDENTIALS_JSON=
FIREBASE_CACHE_TOKENS=true
FIREBASE_TRANSACTION_RETRIES=5
FIREBASE_READ_CACHE=true
# Live banner/queue badge (needs: php artisan firebase:rules --deploy)
FIREBASE_REALTIME_UI=true

# Auth user provider: "rtdb" (reads users straight from Firebase) or "users" (Eloquent, also on Firebase).
AUTH_PROVIDER=rtdb

# Public web config (not secret: shipped to the browser for live updates)
FIREBASE_API_KEY=AIzaSyBK7_M0Ip-Ogsx2QlOHaiOZXcxPvKmOk1s
FIREBASE_AUTH_DOMAIN=e-print-e1185.firebaseapp.com
FIREBASE_STORAGE_BUCKET=e-print-e1185.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=990026970317
FIREBASE_APP_ID=1:990026970317:web:19d60fb445f0929cd02584
FIREBASE_MEASUREMENT_ID=G-R3TSD962VK
